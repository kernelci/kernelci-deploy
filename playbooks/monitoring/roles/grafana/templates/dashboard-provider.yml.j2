# Managed by ansible (kernelci-deploy playbooks/monitoring) - do not edit by hand
apiVersion: 1

providers:
- name: kernelci
  orgId: 1
  type: file
  # Dashboards in the repository cannot be deleted from the UI.
  disableDeletion: true
  updateIntervalSeconds: {{ grafana_dashboards_update_interval }}
{% if grafana_allow_ui_updates %}
  # Without this Grafana refuses to save UI edits to a provisioned dashboard.
  allowUiUpdates: true
{% endif %}
  options:
    path: /etc/grafana/provisioning/{{ grafana_dashboards_subdir }}
    # Each subdirectory of files/dashboards becomes a Grafana folder.
    foldersFromFilesStructure: true
