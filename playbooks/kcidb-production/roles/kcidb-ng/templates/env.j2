# Environment for the kcidb-ng stack.
#
# THIS FILE IS NEVER OVERWRITTEN BY ANSIBLE. It is written once, on a host
# that does not have it yet, as an empty skeleton to fill in by hand. The
# live file holds the JWT secret, the storage token and the database
# password, none of which belong in git.
#
# Database. Production points at Azure managed Postgres, so the self-hosted
# db/dbinit compose services stay behind their profile.
PG_DSN=
PG_PASS=
POSTGRES_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Submission authentication and log handling
JWT_SECRET=
UNIFIED_SECRET=
CONVERT_LOG_EXCERPT=true
KCIDB_VERBOSE=1

# Artifact storage
STORAGE_TOKEN=
STORAGE_BASE_URL=https://files.kernelci.org

# Built-in ACME. Comma separated, every name that resolves to this host and
# should appear in the certificate kcidb-rest obtains and renews itself.
KCIDB_DOMAINS={{ kcidb_acme_domains | default('') }}
CERTBOT_EMAIL=bot@kernelci.org
ACME_WEBROOT=/var/www/acme-challenge
# Only read by the certbot-standalone profile, but compose warns on every
# invocation when it is missing.
CERTBOT_DOMAIN={{ (kcidb_acme_domains | default('')).split(',') | first }}

# Aggregations
AGGREGATION_ENABLED=True
AGGREGATION_INTERVAL=60

# Metrics
PROMETHEUS_PORT=2002
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus
INGEST_CYCLE_BATCH_SIZE=10000
