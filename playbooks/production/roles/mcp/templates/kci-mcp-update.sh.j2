#!/bin/bash
# Managed by ansible (kernelci-deploy playbooks/production) - do not edit by hand
#
# Refresh kci-dev in the MCP virtualenv from whichever source the host is
# configured with, restart the server and verify it still answers. If the new
# build does not come up, reinstall what was running and restart again, so a
# broken release - or a broken commit - cannot leave the public endpoint down.
#
# kci-dev's MCP tools are upstream-flagged as experimental and change between
# releases, which is exactly why this runs on a timer instead of being left to
# whatever pip resolved on the day the host was provisioned. With a git source
# it goes further: the deployed commit follows the branch.
set -u

VENV={{ mcp_home }}/venv
PIP="$VENV/bin/pip"
PY="$VENV/bin/python"
KCI_DEV="$VENV/bin/kci-dev"
URL="http://{{ mcp_bind }}:{{ mcp_port }}/mcp"
SOURCE={{ mcp_source }}
REPO={{ mcp_git_repo }}
REF={{ mcp_git_ref }}

version() {
    "$KCI_DEV" --version 2>/dev/null | awk '{print $NF}'
}

# Where the installed kci-dev came from, as pip recorded it: git+URL@COMMIT,
# or nothing at all for a release build.
origin() {
    "$PY" - <<'PY'
import json, sys
from importlib.metadata import distribution, PackageNotFoundError
try:
    raw = distribution('kci-dev').read_text('direct_url.json') or ''
except PackageNotFoundError:
    raw = ''
info = json.loads(raw) if raw else {}
vcs = info.get('vcs_info', {})
if vcs.get('commit_id'):
    sys.stdout.write('%s+%s@%s' % (vcs.get('vcs', 'git'), info['url'], vcs['commit_id']))
PY
}

healthy() {
    local i code
    for i in $(seq 1 30); do
        code=$(curl -s -o /dev/null -w '%{http_code}' -X POST "$URL" \
            -H 'Content-Type: application/json' \
            -H 'Accept: application/json, text/event-stream' \
            -d '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"kci-mcp-update","version":"1"}}}')
        [ "$code" = "200" ] && return 0
        sleep 2
    done
    return 1
}

before=$(version)
if [ -z "$before" ]; then
    echo "kci-dev is not installed in $VENV, nothing to update"
    exit 1
fi
was=$(origin)

if [ "$SOURCE" = git ]; then
    sha=$(git ls-remote "$REPO" "$REF" | awk 'NR==1 {print $1}')
    # An unknown ref is a commit id, and a commit does not move.
    [ -z "$sha" ] && sha="$REF"
    want="git+$REPO@$sha"
    if [ "$want" = "$was" ]; then
        echo "kci-dev is already at $REF ($sha)"
        exit 0
    fi
    target="kci-dev[mcp] @ $want"
    # pip counts an installed distribution as satisfying a requirement whose
    # version it matches, and every commit of a branch carries the same
    # version. Without this pip clones, resolves, installs nothing and exits 0.
    flags="--upgrade --force-reinstall"
else
    want=""
    target='kci-dev[mcp]'
    # Coming back from a git build to a release is the same same-version trap.
    flags="--upgrade"
    [ -n "$was" ] && flags="--upgrade --force-reinstall"
fi

if ! $PIP install --quiet $flags "$target"; then
    echo "pip install failed, staying on $before"
    exit 1
fi

after=$(version)
now=$(origin)

if [ "$now" != "$want" ]; then
    echo "pip did not install ${want:-a release build}, the venv holds ${now:-a release build}"
    exit 1
fi

if [ "$SOURCE" = pypi ] && [ "$before" = "$after" ] && [ -z "$was" ]; then
    echo "kci-dev $before is already current"
    exit 0
fi

echo "kci-dev $before -> $after (${want:-release}), restarting"
systemctl restart kci-mcp
if healthy; then
    echo "kci-dev $after is serving"
    exit 0
fi

echo "kci-dev $after failed its health check, rolling back"
if [ -n "$was" ]; then
    # pip recorded the exact commit that was serving, so put that back rather
    # than whatever the branch or PyPI happens to hold now.
    "$PIP" install --quiet --upgrade --force-reinstall "kci-dev[mcp] @ $was"
else
    "$PIP" install --quiet --upgrade --force-reinstall "kci-dev[mcp]==$before"
fi
systemctl restart kci-mcp
if healthy; then
    echo "rolled back to ${was:-$before}"
else
    echo "rollback to ${was:-$before} is not serving either, needs attention"
fi
exit 1
