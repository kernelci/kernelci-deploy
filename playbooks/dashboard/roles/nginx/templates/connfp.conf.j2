# Managed by kernelci-deploy. Capture at the host TCP/TLS terminator.
# Existing access_log directives remain active in the same http context.
# A server/location-level access_log overrides BOTH inherited logs. If one
# is added later, repeat the fingerprint access_log there to retain coverage.
log_format connfp escape=json
    '{"time":"$time_iso8601","host":"$host",'
    '"remote_addr":"$remote_addr","remote_port":"$remote_port",'
    '"connection":"$connection","connection_requests":"$connection_requests",'
    '"request_id":"$request_id","request":"$request",'
    '"status":$status,"body_bytes_sent":$body_bytes_sent,"request_time":$request_time,'
    '"user_agent":"$http_user_agent","referer":"$http_referer",'
    '"tls_protocol":"$ssl_protocol","tls_cipher":"$ssl_cipher",'
    '"tls_alpn":"$ssl_alpn_protocol","tlsfp":"$connfp_tls",'
    '"tcp_syn":"$connfp_syn","tlsfp_registry":"$connfp_registry"}';

tcp_save_syn on;
access_log {{ nginx_fingerprint_log }} connfp;
